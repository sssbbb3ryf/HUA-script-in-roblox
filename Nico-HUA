local function ToggleMainSwitch()
	Config.AutoBhop = not Config.AutoBhop
	Config.Noclip = Config.AutoBhop
	if not Config.AutoBhop then
		timeToBhop = 0
		if simulatedKeys.Shift then
			SimulateKeyPress(Enum.KeyCode.LeftShift, false)
			simulatedKeys.Shift = false
		end
		if simulatedKeys.C then
			SimulateKeyPress(Enum.KeyCode.C, false)
			simulatedKeys.C = false
		end
		if simulatedKeys.W then
			SimulateKeyPress(Enum.KeyCode.W, false)
			simulatedKeys.W = false
		end
		for _, data in ipairs(floorParts) do
			if data.part and data.part.Parent then
				data.part:Destroy()
			end
		end
		floorParts = {}
		RestoreNoclipParts()
	else
		UpdateSimulatedKeys()
	end
	-- 更新图标
	local gui = player:FindFirstChild("PlayerGui")
	if gui then
		local screen = gui:FindFirstChild("MinimalBhopUI")
		if screen then
			local icon = screen:FindFirstChild("MainIcon")
			if icon and icon:IsA("ImageButton") then
				icon.Image = Config.AutoBhop and Config.IconOn or Config.IconOff
			end
		end
	end
end

