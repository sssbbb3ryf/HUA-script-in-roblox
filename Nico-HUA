local function SimulateKeyPress(keyCode, isDown)
	if isDown then
		VirtualInputManager:SendKeyEvent(true, keyCode, false, nil)
	else
		VirtualInputManager:SendKeyEvent(false, keyCode, false, nil)
	end
end

local function UpdateSimulatedKeys()
	if Config.AutoBhop then
		if not simulatedKeys.Shift then
			SimulateKeyPress(Enum.KeyCode.LeftShift, true)
			simulatedKeys.Shift = true
		end
		if not simulatedKeys.C then
			SimulateKeyPress(Enum.KeyCode.C, true)
			simulatedKeys.C = true
		end
		if not simulatedKeys.W then
			SimulateKeyPress(Enum.KeyCode.W, true)
			simulatedKeys.W = true
		end
	elseif Config.AutoShiftW then
		if not simulatedKeys.Shift then
			SimulateKeyPress(Enum.KeyCode.LeftShift, true)
			simulatedKeys.Shift = true
		end
		if simulatedKeys.C then
			SimulateKeyPress(Enum.KeyCode.C, false)
			simulatedKeys.C = false
		end
		if not simulatedKeys.W then
			SimulateKeyPress(Enum.KeyCode.W, true)
			simulatedKeys.W = true
		end
	else
		if simulatedKeys.Shift then
			SimulateKeyPress(Enum.KeyCode.LeftShift, false)
			simulatedKeys.Shift = false
		end
		if simulatedKeys.C then
			SimulateKeyPress(Enum.KeyCode.C, false)
			simulatedKeys.C = false
		end
		if simulatedKeys.W then
			SimulateKeyPress(Enum.KeyCode.W, false)
			simulatedKeys.W = false
		end
	end
end

local function CreateFollowFloor()
	if followFloor.part and followFloor.part.Parent then
		followFloor.part:Destroy()
		followFloor.part = nil
	end
	rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	local floor = Instance.new("Part")
	floor.Size = Vector3.new(6, 0.2, 6)
	floor.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, Config.FloorOffset, 0))
	floor.Anchored = true
	floor.CanCollide = true
	floor.Material = Enum.Material.Neon
	floor.Color = Color3.fromRGB(255, 100, 100)
	floor.Transparency = 0.3
	floor.Name = "FollowFloor"
	floor.Parent = workspace
	followFloor.part = floor
	followFloor.active = true
end

local function UpdateFollowFloor()
	if not Config.AutoShiftW then
		if followFloor.part and followFloor.part.Parent then
			followFloor.part:Destroy()
			followFloor.part = nil
			followFloor.active = false
		end
		return
	end
	rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	if not followFloor.part or not followFloor.part.Parent then
		CreateFollowFloor()
		return
	end
	followFloor.part.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, Config.FloorOffset, 0))
end

local function DetectBHOPText()
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return false, 0 end
	local function searchGUI(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") or 
			   child:IsA("TextEdit") or child:IsA("Label") or child:IsA("Button") then
				local text = child.Text or ""
				if type(text) == "string" and text ~= "" then
					local patterns = {
						"BHOP#(%d+)",
						"BHOP%s*#%s*(%d+)",
						"BHOP#(%d+)%s*",
						"BHOP[#](%d+)",
						"BHOP.*#(%d+)",
					}
					for _, pattern in ipairs(patterns) do
						local number = tonumber(string.match(text, pattern))
						if number then
							return true, number
						end
					end
				end
			end
			if child:GetChildren() then
				local found, num = searchGUI(child)
				if found then
					return true, num
				end
			end
		end
		return false, 0
	end
	return searchGUI(playerGui)
end

local function SwitchToShiftWMode()
	if bhopDetect.shiftWModeActive then return end
	bhopDetect.shiftWModeActive = true
	bhopDetect.shiftWModeStartTime = tick()
	bhopDetect.lastTriggerTime = tick()
	Config.AutoBhop = false
	Config.AutoShiftW = true
	if simulatedKeys.Shift then
		SimulateKeyPress(Enum.KeyCode.LeftShift, false)
		simulatedKeys.Shift = false
	end
	if simulatedKeys.C then
		SimulateKeyPress(Enum.KeyCode.C, false)
		simulatedKeys.C = false
	end
	if simulatedKeys.W then
		SimulateKeyPress(Enum.KeyCode.W, false)
		simulatedKeys.W = false
	end
	UpdateSimulatedKeys()
	CreateFollowFloor()
	print("[BHOP检测] 切换到Shift+W模式，持续 " .. Config.ShiftWModeDuration .. " 秒")
end

local function SwitchBackToBhop()
	if not bhopDetect.shiftWModeActive then return end
	bhopDetect.shiftWModeActive = false
	bhopDetect.currentNumber = 0
	bhopDetect.lastDetectTime = 0
	Config.AutoShiftW = false
	if followFloor.part and followFloor.part.Parent then
		followFloor.part:Destroy()
		followFloor.part = nil
		followFloor.active = false
	end
	if simulatedKeys.Shift then
		SimulateKeyPress(Enum.KeyCode.LeftShift, false)
		simulatedKeys.Shift = false
	end
	if simulatedKeys.C then
		SimulateKeyPress(Enum.KeyCode.C, false)
		simulatedKeys.C = false
	end
	if simulatedKeys.W then
		SimulateKeyPress(Enum.KeyCode.W, false)
		simulatedKeys.W = false
	end
	Config.AutoBhop = true
	UpdateSimulatedKeys()
	print("[BHOP检测] 切回自动连跳模式，检测数据已清理")
end

local function CreateFloor()
	rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	for _, data in ipairs(floorParts) do
		if data.part and data.part.Parent then
			data.part:Destroy()
		end
	end
	floorParts = {}
	local floor = Instance.new("Part")
	floor.Size = Vector3.new(10, 0.3, 10)
	floor.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, Config.FloorOffset, 0))
	floor.Anchored = true
	floor.CanCollide = true
	floor.Material = Enum.Material.Neon
	floor.Color = Color3.fromRGB(0, 255, 200)
	floor.Transparency = 0.3
	floor.Name = "BhopFloor"
	floor.Parent = workspace
	table.insert(floorParts, { part = floor, spawnTime = tick() })
	task.delay(Config.FloorLifetime, function()
		if floor and floor.Parent then
			floor:Destroy()
		end
		for i, data in ipairs(floorParts) do
			if data.part == floor then
				table.remove(floorParts, i)
				break
			end
		end
	end)
end

local function UpdateFloor()
	if not Config.AutoBhop then
		for _, data in ipairs(floorParts) do
			if data.part and data.part.Parent then
				data.part:Destroy()
			end
		end
		floorParts = {}
		return
	end
	local currentTime = tick()
	if currentTime - bhopStats.lastFloorTime >= Config.FloorInterval then
		CreateFloor()
		bhopStats.lastFloorTime = currentTime
	end
end

local function AutoBhop()
	if not Config.AutoBhop then return end
	if not humanoid then return end
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
		timeToBhop = 0.15
		bhopStats.jumpedThisLanding = false
	end
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		if timeToBhop > 0 and not bhopStats.jumpedThisLanding then
			bhopStats.jumpedThisLanding = true
			for i = 1, 10 do
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
		timeToBhop = math.max(0, timeToBhop - 0.025)
	end
end

-- 恢复碰撞
local function RestoreNoclipParts()
	for part, oldValue in pairs(noclipParts) do
		if part and part.Parent then
			pcall(function()
				part.CanCollide = oldValue
			end)
		end
	end
	noclipParts = {}
	noclipLastTouch = {}
end

local function TempDisableCollision(part)
	if not part then return end
	if not part:IsA("BasePart") then return end
	if not part.Parent then return end
	if not character then return end
	if part:IsDescendantOf(character) then return end
	if part.Name == "BhopFloor" or part.Name == "FollowFloor" then return end
	if part.CanCollide == true then
		if noclipParts[part] == nil then
			noclipParts[part] = part.CanCollide
		end
		part.CanCollide = false
		noclipLastTouch[part] = tick()
	end
end

local function UpdateNoclip()
	if not Config.Noclip then
		RestoreNoclipParts()
		return
	end
	if not character or not humanoid or not rootPart then return end
	if not rootPart.Parent then return end
	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude <= 0.05 then
		moveDir = rootPart.CFrame.LookVector
	else
		moveDir = moveDir.Unit
	end
	local center = rootPart.Position + moveDir * Config.NoclipRange
	local boxCFrame = CFrame.new(center)
	local boxSize = Vector3.new(4, 5, 4)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local parts = workspace:GetPartBoundsInBox(boxCFrame, boxSize, params)
	for _, part in ipairs(parts) do
		if part:IsA("BasePart") then
			local partTopY = part.Position.Y + part.Size.Y / 2
			local minWallY = rootPart.Position.Y - 2.2
			if partTopY >= minWallY then
				TempDisableCollision(part)
			end
		end
	end
	local currentTime = tick()
	for part, lastTime in pairs(noclipLastTouch) do
		if currentTime - lastTime >= Config.NoclipRestoreDelay then
			if noclipParts[part] ~= nil then
				if part and part.Parent then
					pcall(function()
						part.CanCollide = noclipParts[part]
					end)
				end
				noclipParts[part] = nil
			end
			noclipLastTouch[part] = nil
		end
	end
end

