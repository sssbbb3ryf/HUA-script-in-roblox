local function ExitScript()
	if scriptExited then return end
	scriptExited = true
	Config.AutoBhop = false
	Config.Noclip = false
	Config.AutoShiftW = false
	if simulatedKeys.Shift then
		SimulateKeyPress(Enum.KeyCode.LeftShift, false)
		simulatedKeys.Shift = false
	end
	if simulatedKeys.C then
		SimulateKeyPress(Enum.KeyCode.C, false)
		simulatedKeys.C = false
	end
	if simulatedKeys.W then
		SimulateKeyPress(Enum.KeyCode.W, false)
		simulatedKeys.W = false
	end
	if followFloor.part and followFloor.part.Parent then
		followFloor.part:Destroy()
		followFloor.part = nil
		followFloor.active = false
	end
	RestoreNoclipParts()
	for _, data in ipairs(floorParts) do
		if data.part and data.part.Parent then
			data.part:Destroy()
		end
	end
	floorParts = {}
	for _, conn in ipairs(connections) do
		if conn then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	connections = {}
	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end
	if _G.MinimalBhopCleanup == ExitScript then
		_G.MinimalBhopCleanup = nil
	end
end

_G.MinimalBhopCleanup = ExitScript

-- ==========================
-- 主循环 (Heartbeat)
-- ==========================

table.insert(connections, RunService.Heartbeat:Connect(function()
	if scriptExited then return end
	rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if Config.AutoBhop then
		local currentTime = tick()
		local isInCooldown = (currentTime - bhopDetect.lastTriggerTime) < Config.CooldownAfterSwitch
		if not isInCooldown then
			local found, number = DetectBHOPText()
			if found and number then
				bhopDetect.currentNumber = number
				bhopDetect.lastDetectTime = currentTime
				if number >= Config.BHOPThreshold and not bhopDetect.shiftWModeActive then
					SwitchToShiftWMode()
				end
			end
		end
	end
	if bhopDetect.shiftWModeActive then
		local elapsed = tick() - bhopDetect.shiftWModeStartTime
		if elapsed >= Config.ShiftWModeDuration then
			SwitchBackToBhop()
		end
	end
	UpdateFollowFloor()
	AutoBhop()
	UpdateFloor()
	UpdateNoclip()
	UpdateSimulatedKeys()
end))
